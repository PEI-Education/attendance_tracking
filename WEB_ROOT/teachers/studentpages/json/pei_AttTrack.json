~[tlist_sql;
    SELECT * FROM (
    	SELECT
    	    u.id,
            u.studentsdcid,
            u.termid,
            u.parent_call_1_staff,
            nvl(u.parent_call_1,0) parent_call_1,
            to_char(u.parent_call_1_date,'~[dateformat]') parent_call_1_date,
            u.parent_call_2_staff,
            nvl(u.parent_call_2,0) parent_call_2,
            to_char(u.parent_call_2_date,'~[dateformat]') parent_call_2_date,
            u.parent_call_3_staff,
            nvl(u.parent_call_3,0) parent_call_3,
            to_char(u.parent_call_3_date,'~[dateformat]') parent_call_3_date,
            u.parent_call_notes,
            nvl(u.student_notification,0) student_notification,
            to_char(u.student_notification_date,'~[dateformat]') student_notification_date,
            u.student_notification_staff,
            nvl(u.concern_2,0) concern_2,
            u.concern_2_req_staff,
            to_char(u.concern_2_req_date,'~[dateformat]') concern_2_req_date,
            u.concern_2_sent_staff,
            to_char(u.concern_2_sent_date, '~[dateformat]') concern_2_sent_date,
            u.concern_2_notes,
            nvl(u.concern_3,0) concern_3,
            u.concern_3_req_staff,
            to_char(u.concern_3_req_date,'~[dateformat]') concern_3_req_date,
            u.concern_3_sent_staff,
            to_char(u.concern_3_sent_date, '~[dateformat]') concern_3_sent_date,
            u.concern_3_notes,           
            nvl(u.concern_4,0) concern_4,
            u.concern_4_req_staff,
            to_char(u.concern_4_req_date,'~[dateformat]') concern_4_req_date,
            u.concern_4_sent_staff,
            to_char(u.concern_4_sent_date, '~[dateformat]') concern_4_sent_date,
            u.concern_4_notes,
             nvl(u.referral,0) referral,
          u.referral_staff,
          to_char(u.referral_date,'~[dateformat]') referral_date,
          u.referral_closed_staff,
          to_char(u.referral_closed_date, '~[dateformat]') referral_closed_date,
          u.referral_notes,                  
            ROW_NUMBER() OVER (PARTITION BY u.studentsdcid, u.termid ORDER BY u.whencreated ASC NULLS LAST, u.id ASC) rn
    	FROM u_pei_att_track u
    	JOIN students s 
    	  ON u.studentsdcid = s.dcid
        WHERE
            u.termid = (
SELECT MIN(t.id)
FROM terms t
JOIN students s ON s.id = ~(curstudid)
JOIN (
    SELECT e.studentid, e.grade_level, e.schoolid, e.schoolname,
           e.entrydate, e.exitdate,
           ROW_NUMBER() OVER (
               PARTITION BY e.studentid
               ORDER BY e.entrydate DESC, e.exitdate DESC,
                        e.schoolid ASC, e.grade_level DESC NULLS LAST,
                        e.schoolname ASC NULLS LAST
           ) AS enrollment_rn
    FROM ps_schoolenrollment e
    JOIN terms school_year
      ON school_year.schoolid = e.schoolid
     AND school_year.yearid = ~(curyearid)
     AND school_year.id = school_year.yearid * 100
    WHERE e.yearid = school_year.yearid
      AND e.studentid = ~(curstudid)
      AND e.entrydate < school_year.lastday
      AND e.exitdate > school_year.firstday
      AND e.entrydate < e.exitdate
) e ON e.studentid = s.id AND e.enrollment_rn = 1
WHERE t.schoolid = ~(curschoolid)
  AND s.schoolid = ~(curschoolid)
  AND t.yearid = ~(curyearid)
  AND (
    (
      e.grade_level BETWEEN 0 AND 9
      AND t.id = t.yearid * 100
    )
    OR
    (
      e.grade_level BETWEEN 10 AND 12
      AND t.id IN (t.yearid * 100 + 1, t.yearid * 100 + 2)
      AND TO_DATE('~[date]', '~[dateformat]')
          BETWEEN t.firstday AND t.lastday
    )
  )
HAVING COUNT(*) = 1
            )
    	    and s.id = ~(curstudid)
            AND s.schoolid = ~(curschoolid)
    ) WHERE rn = 1;nonemessage=-1]
    {
        "id": "~(1)",
        "studentsdcid": "~(2)",
        "termid": "~(3)",
        "calls": {
            "parent_call_1_staff": "~(4;json)",
            "parent_call_1": ~(5;l),
            "parent_call_1_date": "~(6;json)",
            "parent_call_2_staff": "~(7;json)",
            "parent_call_2": ~(8;l),
            "parent_call_2_date": "~(9;json)",
            "parent_call_3_staff": "~(10;json)",
            "parent_call_3": ~(11;l),
            "parent_call_3_date": "~(12;json)",
            "parent_call_notes": "~(13;json)"
        },
        "student": {
            "student_notification": ~(14;l),
            "student_notification_date": "~(15;json)",
            "student_notification_staff": "~(16;json)"
        },
        "concern_2": {
            "concern_2": ~(17;l),
            "concern_2_req_staff": "~(18;json)",
            "concern_2_req_date": "~(19;json)",
            "concern_2_sent_staff": "~(20;json)",
            "concern_2_sent_date": "~(21;json)",
            "concern_2_notes": "~(22;json)"
        },
        "concern_3": {
            "concern_3": ~(23;l),
            "concern_3_req_staff": "~(24;json)",
            "concern_3_req_date": "~(25;json)",
            "concern_3_sent_staff": "~(26;json)",
            "concern_3_sent_date": "~(27;json)",
            "concern_3_notes": "~(28;json)"
        },
        "concern_4": {
            "concern_4": ~(29;l),
            "concern_4_req_staff": "~(30;json)",
            "concern_4_req_date": "~(31;json)",
            "concern_4_sent_staff": "~(32;json)",
            "concern_4_sent_date": "~(33;json)",
            "concern_4_notes": "~(34;json)"
        },
        "referral": {
            "referral": ~(35;l),
            "referral_staff": "~(36;json)",
            "referral_date": "~(37;json)",
            "referral_closed_staff": "~(38;json)",
            "referral_closed_date": "~(39;json)",
            "referral_notes": "~(40;json)"
        }
    }
[/tlist_sql]