[
   ~[tlist_sql;
select recid, termid, studentsdcid, student_number, last_name, first_name, current_grade, term_grade, current_school, term_school, term_schoolname, current_step, current_step_idx, to_char(action_date, 'mm/dd/yyyy') action_date, student_notification, parent_call_1, parent_call_2, parent_call_3, concern_2, concern_3, concern_4, referral, call_points from (
   select 
     u.id recid,
     nvl(u.termid,0) termid,
     u.studentsdcid,
     s.student_number,
     s.last_name,
     s.first_name,
     s.grade_level current_grade,
     pss.grade_level term_grade,
     s.schoolid current_school,
     pss.schoolid term_school,
     pss.schoolname term_schoolname,
     case
         when u.referral = 2 then 'Referral closed'
         when u.referral = 1 then 'Referred to Director'
         when u.concern_4 = 2 then 'Letter 3 sent'
         when u.concern_4 = 1 then 'Letter 3 requested'
         when u.concern_3 = 2 then 'Letter 2 sent'
         when u.concern_3 = 1 then 'Letter 2 requested'
         when u.concern_2 = 2 then 'Letter 1 sent'
         when u.concern_2 = 1 then 'Letter 1 requested'
         when u.parent_call_3 = 3 then 'Call 3 - reached parent'
         when u.parent_call_3 = 1 then 'Call 3 - no contact'
         when u.parent_call_2 = 3 then 'Call 2 - reached parent'
         when u.parent_call_2 = 1 then 'Call 2 - no contact'
         when u.parent_call_1 = 3 then 'Call 1 - reached parent'
         when u.parent_call_1 = 1 then 'Call 1 - no contact'
         when u.student_notification = 1 then 'Student notified'
     else
        'No steps taken'
     end as current_step,
     case
         when u.referral = 2 then 16
         when u.referral = 1 then 15
         when u.concern_4 = 2 then 14
         when u.concern_4 = 1 then 13
         when u.concern_3 = 2 then 11
         when u.concern_3 = 1 then 10
         when u.concern_2 = 2 then 8
         when u.concern_2 = 1 then 7
         when u.parent_call_3 = 3 then 5
         when u.parent_call_3 = 1 then 5
         when u.parent_call_2 = 3 then 4
         when u.parent_call_2 = 1 then 4
         when u.parent_call_1 = 3 then 3
         when u.parent_call_1 = 1 then 3
         when u.student_notification = 1 then 2
     else
        1
     end as current_step_idx,
     coalesce(case when u.referral = 2 then u.referral_closed_date end, u.referral_date, u.concern_4_sent_date, u.concern_4_req_date, u.concern_3_sent_date, u.concern_3_req_date, u.concern_2_sent_date, u.concern_2_req_date, u.parent_call_3_date, u.parent_call_2_date, u.parent_call_1_date, u.student_notification_date) action_date,
     nvl(u.student_notification,0) student_notification,
     nvl(u.parent_call_1,0) parent_call_1,
     nvl(u.parent_call_2,0) parent_call_2,
     nvl(u.parent_call_3,0) parent_call_3,
     nvl(u.concern_2,0) concern_2,
     nvl(u.concern_3,0) concern_3,
     nvl(u.concern_4,0) concern_4,
     nvl(u.referral,0) referral,
     (nvl(u.parent_call_1,0) + nvl(u.parent_call_2,0) + nvl(u.parent_call_3,0)) call_points
  from (
    SELECT u.*,
           ROW_NUMBER() OVER (
               PARTITION BY u.studentsdcid, u.termid
               ORDER BY u.whencreated ASC NULLS LAST, u.id ASC
           ) AS checklist_rn
    FROM u_pei_att_track u
    WHERE u.termid = ~(curtermid)
) u
  join students s
     on s.dcid = u.studentsdcid
  join (
    SELECT e.studentid, e.grade_level, e.schoolid, e.schoolname,
           e.entrydate, e.exitdate,
           ROW_NUMBER() OVER (
               PARTITION BY e.studentid
               ORDER BY e.entrydate DESC, e.exitdate DESC,
                        e.schoolid ASC, e.grade_level DESC NULLS LAST,
                        e.schoolname ASC NULLS LAST
           ) AS enrollment_rn
    FROM ps_schoolenrollment e
    JOIN terms school_year
      ON school_year.schoolid = e.schoolid
     AND school_year.yearid = ~(curyearid)
     AND school_year.id = school_year.yearid * 100
    WHERE e.yearid = school_year.yearid
      AND e.studentid IN (
          SELECT cs.id
          FROM students cs
          JOIN u_pei_att_track c ON c.studentsdcid = cs.dcid
          WHERE c.termid = ~(curtermid)
      )
      AND e.entrydate < school_year.lastday
      AND e.exitdate > school_year.firstday
      AND e.entrydate < e.exitdate
) pss
     on pss.studentid = s.id and pss.enrollment_rn = 1
  where
      u.checklist_rn = 1
       ~[if.is.a.school]and s.schoolid = ~(curschoolid)[/if])
  order by term_grade, last_name]
  {
      "recid": ~(1),
      "termid": ~(2),
      "studentsdcid": ~(3),
      "studentNumber": ~(4),
      "lastName": "~(5;json)",
      "firstName": "~(6;json)",
      "currentGrade": ~(7),
      "termGrade": ~(8),
      "currentSchool": ~(9),
      "termSchool": ~(10),
      "termSchoolName": "~(11;json)",
      "currentStep": "~(12;json)",
      "currentStepIdx": ~(13),
      "stepDate": "~(14;json)",
      "studentNotification": ~(15),
      "parentCall1": ~(16),
      "parentCall2": ~(17),
      "parentCall3": ~(18),
      "concern2": ~(19),
      "concern3": ~(20),
      "concern4": ~(21),
      "referral": ~(22),
      "callPoints": ~(23)
  },
  [/tlist_sql]
  {}
]
  